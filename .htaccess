RewriteEngine On
RewriteBase /uncode/

# Redirect any folder/index.php to folder/
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
RewriteRule ^(.*/)?index\.php$ /uncode/$1 [R=301,L]

# Redirect .php URLs to clean URLs
# /about.php -> /about
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^(.+?)\.php$ /uncode/$1 [R=301,L]

# Allow existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Custom 404 page
ErrorDocument 404 /uncode/404-not-found/index.php